  "cards": [
    {
      "dot": "cyan",
      "title": "Layered Architecture Principles",
      "items": [
        "No SQL in UI: PySide6 view classes invoke application services exclusively",
        "Repository Layer isolates parameterized SQL queries and object mapping",
        "Deterministic transactions ensure consistency across patient and financial records"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic Financials & Clinical Flow",
      "items": [
        "Integer Paise Arithmetic: All charges and payments stored in integer paise (1 INR = 100 paise)",
        "Eliminates IEEE 754 floating-point rounding errors across installments and balances",
        "Chronological, immutable session history tracking VAS pain progression (0–10)"
      ]
    },
    {
      "dot": "violet",
      "title": "Offline Resilience & Data Durability",
      "items": [
        "100% offline desktop operation: zero external cloud or network dependencies",
        "PRAGMA foreign_keys = ON enforced on every SQLite connection",
        "WAL (Write-Ahead Logging) journal mode enables fast concurrent reads without locking",
        "Verified backup archives (.kalyan_bak) bundle SQLite database and patient photos"
      ]
    }
  ]
