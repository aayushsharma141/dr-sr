{
  "components": {
    "schemas": {
      "ActionRequest": {
        "additionalProperties": false,
        "description": "Payload for lifecycle actions requiring optimistic concurrency validation.",
        "properties": {
          "version_id": {
            "minimum": 1.0,
            "title": "Version Id",
            "type": "integer"
          }
        },
        "required": [
          "version_id"
        ],
        "title": "ActionRequest",
        "type": "object"
      },
      "AdminOverviewResponse": {
        "additionalProperties": false,
        "description": "Admin dashboard summary metrics and account totals.",
        "properties": {
          "area": {
            "default": "admin",
            "title": "Area",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "user_counts": {
            "additionalProperties": {
              "$ref": "#/components/schemas/RoleUserCounts"
            },
            "title": "User Counts",
            "type": "object"
          }
        },
        "required": [
          "name",
          "role",
          "user_counts"
        ],
        "title": "AdminOverviewResponse",
        "type": "object"
      },
      "ChangePasswordRequest": {
        "additionalProperties": false,
        "description": "Payload for user password change.",
        "properties": {
          "current_password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "DoctorOverviewResponse": {
        "additionalProperties": false,
        "description": "Doctor dashboard summary including doctor ID and profile name.",
        "properties": {
          "area": {
            "default": "doctor",
            "title": "Area",
            "type": "string"
          },
          "doctor_id": {
            "title": "Doctor Id",
            "type": "integer"
          },
          "doctor_name_en": {
            "title": "Doctor Name En",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "name",
          "role",
          "doctor_id",
          "doctor_name_en"
        ],
        "title": "DoctorOverviewResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Payload for user login authentication.",
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeResponse": {
        "description": "Authenticated user profile, active permissions, and CSRF token.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "doctor_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doctor Id"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "must_change_password": {
            "title": "Must Change Password",
            "type": "boolean"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          },
          "version_id": {
            "title": "Version Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "username",
          "full_name",
          "role",
          "doctor_id",
          "permissions",
          "must_change_password",
          "csrf_token",
          "version_id"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "ReceptionOverviewResponse": {
        "additionalProperties": false,
        "description": "Reception dashboard summary.",
        "properties": {
          "area": {
            "default": "reception",
            "title": "Area",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "name",
          "role"
        ],
        "title": "ReceptionOverviewResponse",
        "type": "object"
      },
      "Role": {
        "description": "System roles authorized across Kalyan Hospital platform.",
        "enum": [
          "ADMIN",
          "RECEPTION",
          "DOCTOR"
        ],
        "title": "Role",
        "type": "string"
      },
      "RoleUserCounts": {
        "additionalProperties": false,
        "description": "Active and inactive user counts for a specific role.",
        "properties": {
          "active": {
            "default": 0,
            "title": "Active",
            "type": "integer"
          },
          "inactive": {
            "default": 0,
            "title": "Inactive",
            "type": "integer"
          }
        },
        "title": "RoleUserCounts",
        "type": "object"
      },
      "SetupAdminRequest": {
        "additionalProperties": false,
        "description": "Payload for creating the initial administrator account.",
        "properties": {
          "full_name": {
            "maxLength": 128,
            "minLength": 2,
            "title": "Full Name",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "setup_code": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Setup Code",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "setup_code",
          "username",
          "full_name",
          "password"
        ],
        "title": "SetupAdminRequest",
        "type": "object"
      },
      "UserCreate": {
        "additionalProperties": false,
        "description": "Payload for creating a new user account.",
        "properties": {
          "doctor_name_en": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doctor Name En"
          },
          "full_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9._-]+$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "full_name",
          "role"
        ],
        "title": "UserCreate",
        "type": "object"
      },
      "UserCreatedOut": {
        "additionalProperties": false,
        "description": "One-time creation response carrying the generated temporary password.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "doctor_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doctor Id"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "is_locked": {
            "title": "Is Locked",
            "type": "boolean"
          },
          "last_login_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Login At"
          },
          "must_change_password": {
            "title": "Must Change Password",
            "type": "boolean"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "temporary_password": {
            "title": "Temporary Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          },
          "version_id": {
            "title": "Version Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "username",
          "full_name",
          "role",
          "doctor_id",
          "is_active",
          "must_change_password",
          "is_locked",
          "last_login_at",
          "created_at",
          "version_id",
          "temporary_password"
        ],
        "title": "UserCreatedOut",
        "type": "object"
      },
      "UserOut": {
        "additionalProperties": false,
        "description": "Public user record response schema.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "doctor_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doctor Id"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "is_locked": {
            "title": "Is Locked",
            "type": "boolean"
          },
          "last_login_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Login At"
          },
          "must_change_password": {
            "title": "Must Change Password",
            "type": "boolean"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          },
          "version_id": {
            "title": "Version Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "username",
          "full_name",
          "role",
          "doctor_id",
          "is_active",
          "must_change_password",
          "is_locked",
          "last_login_at",
          "created_at",
          "version_id"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "UserUpdate": {
        "additionalProperties": false,
        "description": "Payload for modifying an existing user account with optimistic concurrency.",
        "properties": {
          "full_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Role"
              },
              {
                "type": "null"
              }
            ]
          },
          "version_id": {
            "minimum": 1.0,
            "title": "Version Id",
            "type": "integer"
          }
        },
        "required": [
          "version_id"
        ],
        "title": "UserUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Kalyan Hospital API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/overview": {
      "get": {
        "description": "Return administrative overview metrics and user counts across all roles.",
        "operationId": "get_admin_overview_api_admin_overview_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOverviewResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Admin Overview",
        "tags": [
          "areas"
        ]
      }
    },
    "/api/auth/change-password": {
      "post": {
        "description": "Change user password, enforce NIST policy, revoke all sessions, and issue fresh session.",
        "operationId": "change_password_api_auth_change_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Change Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "Authenticate credentials, create server-side session, set cookie, and return MeResponse.\n\nReturns:\n    - 200 with MeResponse and cookie on success.\n    - 429 too_many_attempts with Retry-After when IP failure burst is reached.\n    - 401 invalid_credentials with a generic message for invalid passwords,\n      missing users, or locked/deactivated accounts (no user enumeration).",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Revoke active session and delete session cookie.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "description": "Return profile, active permissions, and CSRF token for the authenticated caller.",
        "operationId": "get_me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/doctor/overview": {
      "get": {
        "description": "Return doctor overview with doctor_id and linked doctor profile.",
        "operationId": "get_doctor_overview_api_doctor_overview_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorOverviewResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Doctor Overview",
        "tags": [
          "areas"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Return health status, database ping, and authoritative setup_required flag (SEC-07).",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Check Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check",
        "tags": [
          "health"
        ]
      }
    },
    "/api/reception/overview": {
      "get": {
        "description": "Return reception overview profile.",
        "operationId": "get_reception_overview_api_reception_overview_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceptionOverviewResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Reception Overview",
        "tags": [
          "areas"
        ]
      }
    },
    "/api/setup/admin": {
      "post": {
        "description": "Initialize the platform with the first administrator account and seal setup.",
        "operationId": "setup_first_admin_api_setup_admin_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupAdminRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Setup First Admin",
        "tags": [
          "setup"
        ]
      }
    },
    "/api/setup/status": {
      "get": {
        "description": "Check whether first-run setup is required or permanently closed.",
        "operationId": "get_setup_status_api_setup_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Setup Status",
        "tags": [
          "setup"
        ]
      }
    },
    "/api/users": {
      "get": {
        "description": "List registered users ordered by identifier with optional active filter.",
        "operationId": "list_all_users_api_users_get",
        "parameters": [
          {
            "in": "query",
            "name": "is_active",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Is Active"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserOut"
                  },
                  "title": "Response List All Users Api Users Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List All Users",
        "tags": [
          "users"
        ]
      },
      "post": {
        "description": "Create a new user account returning a one-time temporary password.",
        "operationId": "create_new_user_api_users_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserCreatedOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create New User",
        "tags": [
          "users"
        ]
      }
    },
    "/api/users/{id}": {
      "get": {
        "description": "Retrieve details for a single user record.",
        "operationId": "get_user_detail_api_users__id__get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get User Detail",
        "tags": [
          "users"
        ]
      },
      "patch": {
        "description": "Update user account details subject to optimistic concurrency version check.",
        "operationId": "update_existing_user_api_users__id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
