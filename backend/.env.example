# Kalyan Hospital Management System - Backend Environment Configuration Example
# Copy this file to `backend/.env` and replace CHANGE_ME placeholders with real values.
# IMPORTANT: backend/.env is git-ignored and MUST NEVER be committed to version control.
# IMPORTANT: Database passwords MUST use letters and digits only (percent-encoding breaks Alembic Config).
# The backend application will validate configuration and REFUSE to start if any password is empty or equals CHANGE_ME.

# Runtime environment (development, test, production)
KALYAN_ENV=development

# Database server host address (PostgreSQL bound to localhost on LAN server)
KALYAN_DB_HOST=127.0.0.1

# Database server TCP port
KALYAN_DB_PORT=5432

# Target database name (kalyan_dev for development, kalyan for production)
KALYAN_DB_NAME=kalyan_dev

# Runtime application user (DML only, no DDL/DROP/CREATE permissions)
KALYAN_DB_APP_USER=kalyan_app

# Runtime application user password (letters and digits only)
KALYAN_DB_APP_PASSWORD=CHANGE_ME

# Schema owner user (used strictly for running Alembic migrations)
KALYAN_DB_OWNER_USER=kalyan_owner

# Schema owner user password (letters and digits only)
KALYAN_DB_OWNER_PASSWORD=CHANGE_ME

# Cookie Secure flag: false under D-01 plain HTTP on hospital LAN; true if HTTPS enabled
KALYAN_COOKIE_SECURE=false

# Session cookie name
KALYAN_COOKIE_NAME=kalyan_session

# Sliding session idle expiration in minutes (D-07)
KALYAN_SESSION_IDLE_MINUTES=30

# Maximum absolute session lifetime in hours from initial login
KALYAN_SESSION_ABSOLUTE_HOURS=12

# Optional comma-separated list of additional allowed HTTP origins for CSRF validation (e.g. Vite dev server)
KALYAN_EXTRA_ALLOWED_ORIGINS=http://localhost:5173

# Absolute path to frontend static distribution folder for production SPA hosting (e.g. D:\dr-sr\frontend\dist)
KALYAN_FRONTEND_DIST=

