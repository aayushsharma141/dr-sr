# Kalyan Hospital server - optional configuration
# Copy to `.env` only if you need to change a default. Every value below is
# optional; the server works with sensible defaults out of the box.

# Port the server listens on (default 3000)
PORT=3000

# Bind address. 0.0.0.0 = reachable from other PCs on the LAN (default).
# Use 127.0.0.1 only if you are testing on a single PC.
KH_HOST=0.0.0.0

# Where the database, uploads, backups and keys are stored (default ./data)
# KH_DATA_DIR=D:\KalyanHospital\data

# development | production  (default production)
NODE_ENV=production

# Timezone used for "today" in reports and receipt timestamps
TZ=Asia/Kolkata

# ---------------------------------------------------------------------------
# Security tuning - change these only if you understand the trade-off
# ---------------------------------------------------------------------------
# Extra browser origins allowed to POST (normally not needed: the app is
# served from the same origin it talks to).
# KH_TRUSTED_ORIGINS=http://192.168.1.10:3000

# CSP frame-ancestors / iframe embedding.
# Default is "'none'" (the app refuses to render inside a frame at all - the
# safest setting for medical data). Only override for internal dashboards.
# KH_FRAME_ANCESTORS='none'

# Password hashing cost (scrypt N). Lower = faster logins, weaker hashes.
# 32768 is the default. Do not go below 16384.
# KH_SCRYPT_N=32768

# Idle session timeout in minutes (default 20) and absolute session lifetime
# in hours (default 12).
# KH_SESSION_IDLE_MIN=20
# KH_SESSION_MAX_HOURS=12

# Nightly backup hour, 0-23 (default 22:00 server-local time)
# KH_BACKUP_HOUR=22
