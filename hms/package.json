{
  "name": "kalyan-hospital-lan",
  "version": "1.0.0",
  "private": true,
  "description": "Kalyan Hospital - offline LAN hospital management system (patients, clinical records, billing, audit, backups)",
  "license": "UNLICENSED",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 test/",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset --yes",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "users": "node scripts/users.js",
    "audit:verify": "node scripts/audit-verify.js",
    "portable": "node scripts/make-portable.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "^5.1.0"
  },
  "keywords": [
    "hospital",
    "clinic",
    "emr",
    "offline",
    "lan"
  ]
}
